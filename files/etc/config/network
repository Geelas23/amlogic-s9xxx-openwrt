config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd22:9972:e834::/48'
	option packet_steering '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	list ports 'eth0.10'
	option ipv6 '0'
	option multicast '0'
	option sendredirects '1'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option netmask '255.255.255.0'
	option ipaddr '192.168.0.118'
	option multipath 'off'
	option delegate '0'

config device
	option name 'eth0'
	option ipv6 '0'
	option multicast '0'
	option sendredirects '1'
