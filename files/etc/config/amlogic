
config amlogic 'config'
	option enable '1'
	option amlogic_firmware_repo 'https://github.com/ophub/amlogic-s9xxx-openwrt'
	option amlogic_firmware_tag '_lede_master_'
	option amlogic_firmware_suffix '.img.gz'
	option amlogic_kernel_path 'https://github.com/ophub/kernel'
	option amlogic_kernel_tags 'kernel_stable'
	option amlogic_kernel_branch '6.12'
	option amlogic_plugin_branch 'main'
	option amlogic_write_bootloader '0'
	option amlogic_shared_fstype 'btrfs'
	option menu_install 'yes'
	option menu_armcpu 'yes'
	option amlogic_firmware_config '0'

config settings 'armcpu'
	option governor0 'schedutil'
	option minfreq0 '1000000'
	option maxfreq0 '1512000'

